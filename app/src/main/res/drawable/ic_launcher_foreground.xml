<?xml version="1.0" encoding="utf-8"?>
<!--
  The Sift mark: three bars tapering as they descend - a lot of notifications in, a few out.
  Also serves as the themed (monochrome) icon, so it must read as one flat colour with no
  overlaps. Geometry is mirrored in docs/icon.svg.

  All three bars sit inside the 66dp safe circle (centre 54,54, radius 33) so no launcher
  mask can clip them.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M33.5,37h41a3.5,3.5 0,0 1,0 7h-41a3.5,3.5 0,0 1,0 -7Z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M41.5,50.5h25a3.5,3.5 0,0 1,0 7h-25a3.5,3.5 0,0 1,0 -7Z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M49.5,64h9a3.5,3.5 0,0 1,0 7h-9a3.5,3.5 0,0 1,0 -7Z" />
</vector>
